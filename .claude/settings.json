{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "defaultMode": "bypassPermissions",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright",
    "serena"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "hal hook stop",
            "timeout": 300,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Bash",
      "Write",
      "mcp__ide",
      "WebFetch",
      "mcp__serena",
      "WebSearch",
      "mcp__playwright"
    ],
    "deny": []
  }
}
